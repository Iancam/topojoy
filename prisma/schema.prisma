// }

model OrderItem {
  id    String @id @default(cuid())
  // nonce String @unique

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subcategoryId Int 
  
  mapConfigId String?
  mapConfig MapConfig? @relation(fields: [mapConfigId], references: [id], onDelete: SetNull)

  width Int 
  height Int 
  
  currency   String  @default("USD")
  quantity Int @default(1)
  itemPrice Int //in cents 
  totalPrice Int //in cents
  userContribution Int //in cents
  orderItemOptions Json 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}