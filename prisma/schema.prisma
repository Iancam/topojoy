// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  clerkId String @unique @db.VarChar(255)
  email String? @db.VarChar(255)
  name  String @db.VarChar(255)
  mapConfigs MapConfig[]
  orders Order[]
  donations Donation[]
  giftGivers GiftGiver[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum featureType {
  mountain
  river
  trail
  lake
}

model Feature {
  // id    String @id @default(cuid())
  mapConfigId String
  
  name  String @db.VarChar(255)
  selected Boolean @default(false)
  type featureType @default(mountain)
  
  mapConfig MapConfig @relation(fields: [mapConfigId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([name, mapConfigId, type])
}

model Annotation {
  id    String @id @default(cuid())
  mapConfigId String
  mapConfig MapConfig @relation(fields: [mapConfigId], references: [id])
  text String
  fontSize Int
  color String
  xRatio Float
  yRatio Float
}

model MapConfig {
  id    String @id @default(cuid())
  user  User @relation(fields: [userId], references: [clerkId])
  userId String
  
  filename String @db.VarChar(255) @default(dbgenerated("gen_random_uuid()"))
  title String @db.VarChar(128)
  config String @db.VarChar(64)
  zoomLevel Int
  curveDensity Int

  features Feature[]
  bbox Json 
  selectedTrails Json? 

  backgroundText String?
  backgroundTextElevationRange0 Float
  backgroundTextElevationRange1 Float
  backgroundTextHighContrast Boolean

  annotations Annotation[]

  crossHatch Boolean
  colorPlan String @db.VarChar(255)

  imageUrl String?
  s3Key String?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([filename, userId])
}

model Recipient {
  id    String @id @default(cuid())
  name String @db.VarChar(255)
  email String? @db.VarChar(128)
  phone String? @db.VarChar(64)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String?
  postalCode     String
  country        String

  orders Order[]
}

model Order {
  id    String @id @default(cuid())
  // nonce String @unique

  status String @default("pending")
  shippingMethod String @default("standard")

  currency   String  @default("USD")
  totalPrice Int @default(0) //in cents

  recipientId String?
  recipient Recipient? @relation(fields: [recipientId], references: [id])

  orderItems OrderItem[]

  userId String?
  user User? @relation(fields: [userId], references: [clerkId])

  submissionErrorMessage String?
  submissionErrorAt DateTime?

  paymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model OrderItem {
  id    String @id @default(cuid())
  // nonce String @unique

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subcategoryId Int 
  
  mapConfigId String?
  mapConfig MapConfig? @relation(fields: [mapConfigId], references: [id], onDelete: SetNull)

  width Int 
  height Int 
  
  currency   String  @default("USD")
  quantity Int @default(1)
  itemPrice Int //in cents 
  totalPrice Int //in cents
  userContribution Int //in cents
  orderItemOptions Json 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id String @id @default(cuid())
  amount Int
  restricted Boolean  //— how the money can be spent (alone vs. combined)
  public Boolean //— who can access it (anyone vs. private link holder)
  message String
  donateResiduals Boolean
  donorId String
  donor User @relation(fields: [donorId], references: [id])
  exipiryDate DateTime
  giftGivers GiftGiver[]
}

model GiftGiver {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  donations Donation[]
  gratitudeMessage String?
  reflections String?
  giftedMaps GiftedMap[]
}

model GiftedMap {
  id String @id @default(cuid())
  amount Int //in cents
  orderId String
  gratitudeMessage String?
  order Order @relation(fields: [orderId], references: [id])
  giftGiverId String
  giftGiver GiftGiver @relation(fields: [giftGiverId], references: [userId])
}