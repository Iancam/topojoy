generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  clerkId String @unique @db.VarChar(255)
  email String? @db.VarChar(255)
  name  String @db.VarChar(255)
  mapConfigs MapConfig[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum featureType {
  mountain
  river
  trail
  lake
}

model Feature {
  // id    String @id @default(cuid())
  mapConfigId String
  
  name  String @db.VarChar(255)
  selected Boolean @default(false)
  type featureType @default(mountain)
  
  mapConfig MapConfig @relation(fields: [mapConfigId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([name, mapConfigId, type])
}

model MapConfig {
  id    String @id @default(cuid())
  user  User @relation(fields: [userId], references: [clerkId])
  userId String
  
  filename String @db.VarChar(255) @default(dbgenerated("gen_random_uuid()"))
  title String @db.VarChar(128)
  config String @db.VarChar(64)
  zoomLevel Int
  curveDensity Int

  features Feature[]
  bbox Json 
  selectedTrails Json? 

  backgroundText String?
  backgroundTextElevationRange0 Float
  backgroundTextElevationRange1 Float
  backgroundTextHighContrast Boolean

  crossHatch Boolean
  colorPlan String @db.VarChar(255)

  imageUrl String?
  s3Key String?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([filename, userId])
}

model Recipient {
  id    String @id @default(cuid())
  name String @db.VarChar(255)
  email String? @db.VarChar(128)
  phone String? @db.VarChar(64)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String?
  postalCode     String
  country        String

  orders Order[]
}

model Order {
  id    String @id @default(cuid())
  // nonce String @unique

  status String @default("pending")
  shippingMethod String @default("standard")

  currency   String  @default("USD")
  totalPrice Int @default(0) //in cents

  recipientId String?
  recipient Recipient? @relation(fields: [recipientId], references: [id])

  orderItems OrderItem[]

  userId String?
  user User? @relation(fields: [userId], references: [clerkId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

