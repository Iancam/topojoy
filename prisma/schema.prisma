generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  clerkId String @unique @db.VarChar(255)
  email String? @db.VarChar(255)
  name  String @db.VarChar(255)
  mapConfigs MapConfig[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum featureType {
  mountain
  river
  trail
  lake
}

model Feature {
  // id    String @id @default(cuid())
  mapConfigId String
  
  name  String @db.VarChar(255)
  selected Boolean @default(false)
  type featureType @default(mountain)
  
  mapConfig MapConfig @relation(fields: [mapConfigId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([name, mapConfigId, type])
}

model MapConfig {
  id    String @id @default(cuid())
  user  User @relation(fields: [userId], references: [clerkId])
  userId String
  
  title String @db.VarChar(128)
  config String @db.VarChar(64)
  zoomLevel Int
  curveDensity Int

  features Feature[]
  bbox Json 
  selectedTrails Json? 

  backgroundText String?
  backgroundTextElevationRange0 Float
  backgroundTextElevationRange1 Float
  backgroundTextHighContrast Boolean

  crossHatch Boolean
  colorPlan String @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}