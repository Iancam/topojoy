// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique @db.VarChar(255)
  username  String?   @unique @db.VarChar(64)
  email     String?   @db.VarChar(255)
  name      String    @db.VarChar(255)
  mapConfigs MapConfig[]
  orders    Order[]
  donations Donation[]
  giftedMapsGiven    GiftedMap[] @relation("GiftGiver")
  giftedMapsReceived GiftedMap[] @relation("GiftRecipient")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(128)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum featureType {
  mountain
  river
  trail
  lake
}

model Feature {
  // id    String @id @default(cuid())
  mapConfigId String
  
  name  String @db.VarChar(255)
  selected Boolean @default(false)
  type featureType @default(mountain)
  
  mapConfig MapConfig @relation(fields: [mapConfigId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([name, mapConfigId, type])
}

model Annotation {
  id    String @id @default(cuid())
  mapConfigId String
  mapConfig MapConfig @relation(fields: [mapConfigId], references: [id])
  text String
  fontSize Int
  color String
  xRatio Float
  yRatio Float
}

model MapConfig {
  id    String @id @default(cuid())
  user  User @relation(fields: [userId], references: [id])
  userId String
  
  filename String @db.VarChar(255) @default(dbgenerated("gen_random_uuid()"))
  title String @db.VarChar(128)
  config String @db.VarChar(64)
  zoomLevel Int
  curveDensity Int

  features Feature[]
  bbox Json 
  selectedTrails Json? 

  backgroundText String?
  backgroundTextElevationRange0 Float
  backgroundTextElevationRange1 Float
  backgroundTextHighContrast Boolean

  annotations Annotation[]

  crossHatch Boolean
  colorPlan String @db.VarChar(255)

  imageUrl String?
  s3Key String?

  // Array of Clerk user IDs who can edit this map
  collaborators String[] @default([])

  orderItems OrderItem[]
  giftedMaps GiftedMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([filename, userId])
}

model Recipient {
  id    String @id @default(cuid())
  name String @db.VarChar(255)
  email String? @db.VarChar(128)
  phone String? @db.VarChar(64)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String?
  postalCode     String
  country        String

  orders Order[]
}

model Order {
  id    String @id @default(cuid())
  orderNumber String? @unique
  // nonce String @unique

  status String @default("pending")
  shippingMethod String @default("standard")

  currency   String  @default("USD")
  totalPrice Int @default(0) //in cents

  recipientId String?
  recipient Recipient? @relation(fields: [recipientId], references: [id])

  orderItems OrderItem[]

  userId String?
  user User? @relation(fields: [userId], references: [id])

  submissionErrorMessage String?
  submissionErrorAt DateTime?

  paymentIntentId String?

  giftedMap GiftedMap?
  donationAllocations DonationAllocation[]

  submittedAt DateTime?
  paidAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model OrderItem {
  id    String @id @default(cuid())
  // nonce String @unique

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subcategoryId Int 
  
  mapConfigId String?
  mapConfig MapConfig? @relation(fields: [mapConfigId], references: [id], onDelete: SetNull)

  width Int 
  height Int 
  
  currency   String  @default("USD")
  quantity Int @default(1)
  itemPrice Int //in cents 
  totalPrice Int //in cents
  userContribution Int //in cents
  orderItemOptions Json 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id               String               @id @default(cuid())
  amount           Int                  // in cents, original amount
  status           String               @default("pending")
  restricted       Boolean              // true = must be used alone, no stacking
  public           Boolean
  discretionary    Boolean              // -true, can be used by topojoy org
  message          String?
  donateResiduals  Boolean              // if true, leftover goes to communal pool on expiry
  donorId          String?
  donor            User?                 @relation(fields: [donorId], references: [id])
  expiryDate       DateTime
  allocations      DonationAllocation[]
  accessToken      String?              @unique // non-null when public: false
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model GiftedMap {
  id           String    @id @default(cuid())

  giftGiverId  String
  giftGiver    User      @relation("GiftGiver", fields: [giftGiverId], references: [id])

  recipientId  String?
  recipient    User?     @relation("GiftRecipient", fields: [recipientId], references: [id])

  giverMessage      String?
  giverReflection   String?
  recipientMessage  String?
  recipientReflection String?

  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])

  mapConfigId  String?
  mapConfig    MapConfig? @relation(fields: [mapConfigId], references: [id])

  totalCost    Int       // in cents
  createdAt    DateTime  @default(now())
}

model DonationAllocation {
  id          String   @id @default(cuid())
  donationId  String
  donation    Donation @relation(fields: [donationId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  amountDrawn Int      // in cents
  createdAt   DateTime @default(now())
}